rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{id}      { allow read: if true; allow write: if request.auth != null; }
    match /products/{id}   { allow read: if true; allow write: if request.auth != null; }
    match /courses/{id}    { allow read: if true; allow write: if request.auth != null; }
    match /portfolio/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /testimonials/{id} { allow read: if true; allow write: if request.auth != null; }
    match /videos/{id}     { allow read: if true; allow write: if request.auth != null; }

    // Dokumen pengaturan (mis. settings/consultation untuk harga sesi konsultasi):
    // publik boleh baca (dipakai halaman /konsultasi), hanya admin yang boleh ubah.
    match /settings/{id}   { allow read: if true; allow write: if request.auth != null; }

    match /bookings/{id}     { allow read: if request.auth != null; allow write: if request.auth != null; }
    match /subscribers/{id}  { allow read: if request.auth != null; allow write: if request.auth != null; }
    match /contacts/{id}     { allow read: if request.auth != null; allow write: if request.auth != null; }
    match /orders/{id}       { allow read: if request.auth != null; allow write: if request.auth != null; }
  }
}
