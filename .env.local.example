# ====== SITE ======
NEXT_PUBLIC_SITE_URL=https://pakdon.id

# ====== FIREBASE (client - dari Firebase Console > Project Settings > General) ======
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ====== FIREBASE ADMIN (server - dari Firebase Console > Project Settings > Service Accounts > Generate new private key) ======
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Tempel private key di dalam tanda kutip, ganti baris baru dengan \n
FIREBASE_ADMIN_PRIVATE_KEY=""

# ====== AI CHATBOT (Anthropic) ======
# Dapatkan di https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ====== PAYMENT (Midtrans - cocok untuk pasar Indonesia) ======
# Dapatkan di https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ====== NEWSLETTER (opsional, Brevo/Sendinblue) ======
BREVO_API_KEY=
BREVO_LIST_ID=

# ====== WHATSAPP (nomor tujuan notifikasi booking/kontak, format 62xxxxxxxxxx) ======
NEXT_PUBLIC_WHATSAPP_NUMBER=6281200000000
